{
  "name": "@ringplaza/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "npm --workspace @ringplaza/shared run build && tsx watch src/server.ts",
    "build": "npm --workspace @ringplaza/shared run build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "echo \"lint not configured yet\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "npm --workspace @ringplaza/shared run build && tsx scripts/seed.ts",
    "metrics": "tsx scripts/aggregate-metrics.ts"
  },
  "dependencies": {
    "@ringplaza/shared": "0.0.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/sensible": "^5.4.0",
    "fastify-raw-body": "^4.3.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "kysely": "^0.27.3",
    "mercurius": "^13.0.1",
    "pg": "^8.11.3",
    "nodemailer": "^6.9.10",
    "stripe": "^14.10.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
